ENV=dev
JWT_SECRET=a-string-secret-at-least-256-bits-long
OPENAI_API_KEY=your-openai-api-key

WORKERS_CONFIG_PATH=config/workers.yaml

# Origines autorisees par CORS (separees par des virgules). A completer si le
# front tourne sur un autre port que 5173/5174, sinon le preflight echoue en 400.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5436
DB_USERNAME=admin
DB_PASSWORD=admin
DB_DATABASE=highfive
DATABASE_URI=postgresql+asyncpg://admin:admin@localhost:5436/highfive

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_INSIGHT_PORT=5540