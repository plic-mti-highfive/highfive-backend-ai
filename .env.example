# Variables du service IA (voir src/core/config.py). Les secrets ne se committent jamais.
ENV=dev
JWT_SECRET=change-me
OPENAI_API_KEY=change-me
DATABASE_URI=postgresql+asyncpg://admin:admin@127.0.0.1:5432/highfive
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Tests : NE PAS pointer vers la base de dev. Utiliser `scripts/test.sh` (bases jetables).
# Si vous fournissez DATABASE_URI vous-même pour pytest, le nom de la base doit contenir "test" :
# DATABASE_URI=postgresql+asyncpg://admin:admin@127.0.0.1:5432/highfive_test
